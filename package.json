{
  "name": "spectrahub",
  "version": "0.3.1",
  "description": "Self-hosted open-source command center for your own VPS: chat, terminal, files, servers, agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "spectrahub": "bin/spectrahub.js"
  },
  "scripts": {
    "start": "node bin/spectrahub.js serve",
    "doctor": "node bin/spectrahub.js doctor",
    "test": "node --test",
    "check:release": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/*.js",
    "bin/*.py",
    "src/*.js",
    "web/*.js",
    "web/*.css",
    "web/*.html",
    "web/*.png",
    "web/*.webmanifest",
    "docs/INSTALL.md",
    "docs/ARCHITECTURE.md",
    "docs/ROADMAP.md",
    "docs/DECISIONS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "self-hosted",
    "command-center",
    "dashboard",
    "vps",
    "agents",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectrahqteam/spectrahub.git"
  },
  "homepage": "https://github.com/spectrahqteam/spectrahub",
  "bugs": {
    "url": "https://github.com/spectrahqteam/spectrahub/issues"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
